{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(compact|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -I -B \"~/.claude/hooks/uguard_hook.py\" --client claude --event SessionStart --state-dir \"~/.claude/hooks/state\" --log-dir \"~/.claude/hooks/logs\"",
            "timeout": 45,
            "statusMessage": "恢复本会话用户原话与交接状态"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -I -B \"~/.claude/hooks/uguard_hook.py\" --client claude --event PostCompact --state-dir \"~/.claude/hooks/state\" --log-dir \"~/.claude/hooks/logs\"",
            "timeout": 10,
            "statusMessage": "检查长会话交接状态"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -I -B \"~/.claude/hooks/uguard_hook.py\" --client claude --event UserPromptSubmit --state-dir \"~/.claude/hooks/state\" --log-dir \"~/.claude/hooks/logs\"",
            "timeout": 10,
            "statusMessage": "检查长会话交接状态"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -I -B \"~/.claude/hooks/uguard_hook.py\" --client claude --event PreToolUse --state-dir \"~/.claude/hooks/state\" --log-dir \"~/.claude/hooks/logs\"",
            "timeout": 15,
            "statusMessage": "检查工作区写边界、票据与交接状态"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -I -B \"~/.claude/hooks/uguard_hook.py\" --client claude --event Stop --state-dir \"~/.claude/hooks/state\" --log-dir \"~/.claude/hooks/logs\"",
            "timeout": 15,
            "statusMessage": "检查回合回执、重复回复与交接状态"
          }
        ]
      }
    ]
  }
}

{
  "schema_version": 1,
  "profile_id": "fleet-snapshot-v2",
  "evaluated_at": "2026-11-19",
  "evaluation_policy": {
    "bidirectional_strength_and_defect_audit": true,
    "all_roles_dynamic": true,
    "dynamic_tunables_enabled": true,
    "dynamic_matrix_policy": "五个角色槽位（orchestrator、math、code、review、fast）与运行期定量参数（runtime_tunables）均随客户端协议、模型能力、上下文压缩特性与配额策略由 fleet-evolve 动态重算，不与单一客户端、固定模型或静态死数字永久绑定；当前快照仅反映现阶段实测结果。",
    "defect_veto_priority": "同步核查各客户端与模型的优势与短板；实测优势决定当前角色分工，严重短板（平台区域访问受限、高频会话配额上限、协议转换反代丢包、自动派生子代理死等、长对话压缩丢失早期约束）作为排除或参数隔离依据。",
    "user_approval_required_before_apply": true,
    "approval_checkpoints": [
      "生成或调整推荐的客户端 × 模型 × 推理强度矩阵及运行期定量参数（runtime_tunables）时须停下请用户审定",
      "向宿主机全局目录写入配置（install.py 正式执行）或切换主会话客户端时须先获用户批准（R4）",
      "涉及系统级 Python 跨次版本、CUDA 跨大版本或 WSL 跨 LTS 发行版等 ABI 强耦合升级时须发出警告并交由用户决定",
      "执行 git push 推送远端仓库前须停下等待用户明确指令"
    ]
  },
  "roles": {
    "orchestrator": {
      "candidates": [
        "agy:@orchestrator",
        "codex:@orchestrator",
        "claude:@orchestrator",
        "dsh:@orchestrator"
      ],
      "recommended_client": "antigravity",
      "recommended_model_family": "neon",
      "recommended_tier": "high",
      "strengths": "现阶段中文工程表达自然平实，适合承担课题需求澄清、物理与数值方案权衡及主会话统筹；Gemini 4 Neon 提供 Low、Medium、High、XHigh 四挡与 1,000,000 token 窗口，吞吐速度约为同代 Carbon 的两倍，在编码代理与科学终端基准领先，CLI 支持流式 JSON 与原生 --json-schema 结构化输出校验，直接使用客户端订阅的模型组滚动配额（5 小时窗口与 7 天周期额度），无需单独按量采购 API；同代 Carbon 保持启用供深度抗幻觉核查点名调用。",
      "defects_and_mitigations": "交互式会话在约 20 万至 26 万 token 附近会触发自动检查点压缩，且 agy models 命令不输出整数窗口字段；Neon 在极长上下文召回与无工具幻觉率上略逊于 Carbon。通过 R9 钩子按 runtime_tunables.compaction_recovery.per_client.antigravity 与 hooks/_lib/adaptive_policy.py 动态恢复历轮用户原话与实质子代理返回摘要，在 cae_harness.py 中按保守单分片预算规划审查，辅以 R6 原文行号复核与 check-grounding --strict，并通过 blocked_auto_tokens 与 agy_retiring_patterns 跳过共享窗口复合模式及待退役第三方模型。"
    },
    "math": {
      "candidates": [
        "codex:math",
        "codex:code",
        "agy:@math",
        "dsh:math",
        "claude:math"
      ],
      "recommended_client": "codex",
      "recommended_model_family": "astra",
      "recommended_tier": "max",
      "strengths": "现阶段主力 gpt-6.2-astra 擅长长链条偏微分方程离散推导、守恒与熵稳定条件证明、雅可比矩阵求导与边界条件相容性分析；客户端缓存声明最大窗口 872,000 token（有效窗口比例 95%，单分片安全预算 745,560 token），科学终端与长程推演表现较上代 gpt-6-astra 显著提升且成本更低，连续工具调用自动复用服务端前缀缓存，支持 ChatGPT 订阅配额（5 小时滚动窗口与周度上限）或按量 API。",
      "defects_and_mitigations": "客户端缓存默认推理强度为 low、默认窗口为 272,000 token，不显式传参无法用满窗口与推理深度；开启 ultra 委派挡位会自动派生多层子代理引发轮询超时。由 install.py 与 cae_harness.py 显式声明最大窗口与单模型非委派最高挡 max，并在只读任务前后比对工作区文件哈希快照。"
    },
    "code": {
      "candidates": [
        "codex:code",
        "codex:math",
        "claude:code",
        "agy:@code",
        "dsh:code"
      ],
      "recommended_client": "codex",
      "recommended_model_family": "sol",
      "recommended_tier": "max",
      "strengths": "现阶段主力 gpt-6.2-sol 适合核心数值求解器实现、跨模块重构以及配合验证命令（gate --verify-cmd）执行多轮闭环修复；客户端缓存声明最大窗口 872,000 token（单分片安全预算 745,560 token），多文件补丁修改稳定且输出更精炼。",
      "defects_and_mitigations": "客户端缓存默认推理强度为 low、默认窗口为 500,000 token，且在 Windows 下无范围遍历大型目录时易因进程调用开销触发超时；脚本显式传入 max 挡位与最大窗口，派发任务须配合 --write-scope 与精确行号限定范围。"
    },
    "review": {
      "candidates": [
        "codex:review",
        "dsh:review",
        "agy:@review",
        "claude:review"
      ],
      "recommended_client": "codex",
      "recommended_model_family": "sol",
      "recommended_tier": "max",
      "strengths": "现阶段独立代码与文档审查优先跨客户端调用 Codex gpt-6.2-sol（872,000 token 窗口）、DeepSeek Harness 内置 DeepSeek-V4-Pro（1,048,576 token 窗口）及 Antigravity neon/carbon 系列；Claude Code 客户端保留完整的五类生命周期钩子、原生 --json-schema 结构化输出校验及本地 router.py 与 CC Switch 卡片通道，按 subscription_matrix 中已启用的卡片模型参与调度。",
      "defects_and_mitigations": "Claude Code 当前启用的 DeepSeek 卡片为轻量模型 deepseek-flash[1M]，由脚本硬性拦截其冒充非 fast 审查角色主力；严禁接入第三方 Responses API 协议转换反代，无头只读调用固定附加 --permission-mode dontAsk 以规避 auto 分类器限流报错。"
    },
    "fast": {
      "candidates": [
        "dsh:fast",
        "claude:fast",
        "agy:@fast",
        "codex:@fast"
      ],
      "recommended_client": "dsh",
      "recommended_model_family": "deepseek-flash",
      "recommended_tier": "low",
      "strengths": "现阶段通过官方账号登录（deepseek-account）或 DEEPSEEK_API_KEY（~/.dsh/.credentials.yaml 或 .env）即可直连，内置 DeepSeek-V4-Pro 与 DeepSeek-V4.1-Flash 均声明 1,048,576 token 窗口（单分片安全预算 943,718 token，支持 off、low、high、max 四挡）；Antigravity 同代轻量系列 Gemini 4 Hydrogen 同时提供 Low 与 XHigh 挡位。既可单客户端独立使用，也可在显式省额度或其他客户端进入配额冷却时无损接替。",
      "defects_and_mitigations": "DSH 命令行暂未内置生命周期钩子与原生 --json-schema 参数，长文本回执偶发包裹代码块围栏或附带底层 DSML 停止标记；由 cae_harness.py 注入单 JSON 对象输出约束并执行平衡对象解码与 DSML 尾部清洗。轻量挡仅用于显式省额度或快速表面检查，不静默替代高严谨度推导与核心审查。"
    }
  },
